#!/usr/bin/env bash
# Local IANA timezone coordinates + NOAA solar calculation; no network calls.
set -euo pipefail

zone=$(readlink -f /etc/localtime | sed -n 's#^/usr/share/zoneinfo/##p')
coords=$(awk -v z="$zone" '$3 == z { print $2; exit }' /usr/share/zoneinfo/zone.tab)
[[ -n $coords ]] || exit 0
read -r sunrise sunset < <(awk -v c="$coords" '
function r(x){return x*atan2(0,-1)/180} function d(x){return x*180/atan2(0,-1)} function n(x){x%=360;return x<0?x+360:x}
function dec(p,k,s,x,g,m,q){s=substr(p,1,1)=="-"?-1:1;x=substr(p,2);g=substr(x,1,k);m=substr(x,k+1,2);q=length(x)>k+2?substr(x,k+3,2):0;return s*(g+m/60+q/3600)}
function sun(up,N,lat,lon,L,t,M,S,A,ql,qr,sd,cd,ch,H,T,U){L=lon/15;t=N+((up?6:18)-L)/24;M=.9856*t-3.289;S=n(M+1.916*sin(r(M))+.020*sin(r(2*M))+282.634);A=n(d(atan2(.91764*sin(r(S)),cos(r(S)))))/15;ql=int(S/90)*90;qr=int(A*15/90)*90;A+=(ql-qr)/15;sd=.39782*sin(r(S));cd=sqrt(1-sd*sd);ch=(cos(r(90.833))-sd*sin(r(lat)))/(cd*cos(r(lat)));if(ch>1||ch< -1)return -1;H=up?360-d(atan2(sqrt(1-ch*ch),ch)):d(atan2(sqrt(1-ch*ch),ch));T=H/15+A-.06571*t-6.622;U=(T-L)%24;if(U<0)U+=24;return midnight+int(U*3600+.5)}
BEGIN{p=match(substr(c,2),/[+-]/)+1;lat=dec(substr(c,1,p-1),2);lon=dec(substr(c,p),3);q="date -u -d \"today 00:00\" +%s";q|getline midnight;close(q);q="date +%j";q|getline day;close(q);print sun(1,day,lat,lon),sun(0,day,lat,lon)}')
[[ $sunrise =~ ^[0-9]+$ && $sunset =~ ^[0-9]+$ ]] || exit 0

now=$(date +%s)
(( now >= sunset || now < sunrise )) && desired=true || desired=false

state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/auto-nightlight"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy/auto-nightlight"
mkdir -p "$state" "$runtime"
override="$state/manual-override"
last="$runtime/last-scheduled-state"

set_state() {
  [[ $1 == true ]] && action=enable || action=disable
  omarchy shell nightlight "$action" >/dev/null
}

override_state=""
if [[ -e $override ]]; then
  age=$((now - $(stat -c %Y "$override" 2>/dev/null || printf '0')))
  override_state=$(<"$override")
  if (( age < 0 || age >= 43200 )) ||
     [[ $override_state != true && $override_state != false ]]; then
    rm -f "$override" "$last"
    override_state=""
  fi
fi

# First check of a login: restore a valid override, otherwise apply the schedule.
if [[ ! -r $last ]]; then
  if [[ -n $override_state && $override_state != "$desired" ]]; then
    set_state "$override_state"
  else
    rm -f "$override"
    set_state "$desired"
  fi
  printf '%s\n' "$desired" >"$last"
  exit 0
fi

current=$(omarchy shell nightlight status 2>/dev/null | jq -r '.enabled')
[[ $current == true || $current == false ]] || exit 1

# Matching the schedule always ends a manual override.
if [[ $current == "$desired" ]]; then
  rm -f "$override"
  printf '%s\n' "$desired" >"$last"
  exit 0
fi

# A valid override owns the opposite state until it expires.
[[ -n $override_state ]] && exit 0

# A changed schedule is automatic; an unchanged schedule means the user toggled.
if [[ "$(<"$last")" != "$desired" ]]; then
  set_state "$desired"
  printf '%s\n' "$desired" >"$last"
else
  printf '%s\n' "$current" >"$override"
fi
